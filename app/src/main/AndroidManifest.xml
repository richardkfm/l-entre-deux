<?xml version="1.0" encoding="utf-8"?>
<!--
  Privacy and permissions:
  This manifest deliberately keeps permissions minimal. Adding any new
  permission requires updating docs/permissions-and-risks.md and
  docs/privacy-principles.md in the same change. INTERNET is not
  requested; the app does not talk to a network.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Declare visibility into apps that have a launcher intent so
      PackageManager.queryIntentActivities can enumerate them.
      QUERY_ALL_PACKAGES is deliberately not used.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".EntreDeuxApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EntreDeux"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EntreDeux">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Receives the pinned-shortcut intent so tapping a home-screen
              shortcut routes through the pause flow. singleTop means a tap
              while the app is already in the foreground calls onNewIntent
              instead of creating a second instance.
            -->
            <intent-filter>
                <action android:name="org.entredeux.app.action.PAUSE_LAUNCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
