    <!-- Epigraphs shown at random on each pause, signed like a book's.
         French originals by writers now in the public domain; the English
         lines are this project's own translations. Keep them calm: no
         urgency, scarcity or guilt. pause_epigraph_author has the same order. -->
    <string-array name="pause_epigraph_text">
        <item>When I dance, I dance; when I sleep, I sleep.</item>
        <item>Attention is the rarest and purest form of generosity.</item>
        <item>The greatest thing in the world is to know how to belong to oneself.</item>
        <item>The wind is rising. We must try to live.</item>
        <item>“I have done nothing today.” What? Have you not lived?</item>
        <item>My trade and my art is living.</item>
    </string-array>
    <string-array name="pause_epigraph_author" translatable="false">
        <item>Montaigne</item>
        <item>Simone Weil</item>
        <item>Montaigne</item>
        <item>Paul Valéry</item>
        <item>Montaigne</item>
        <item>Montaigne</item>
    </string-array>
    <!-- Material look: the epigraph on one line. %1$s text, %2$s author. -->
    <string name="pause_epigraph_line" translatable="false">%1$s — %2$s</string>

