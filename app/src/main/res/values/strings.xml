    <string name="onboarding_get_started">Get started</string>
    <string name="onboarding_page1_heading">A moment in between</string>
    <string name="onboarding_page1_body">Between reaching for a chosen app and opening it, l\'entre-deux makes a little room — to notice what you actually came for. You pick the apps, and you can always go ahead.</string>
    <string name="onboarding_page2_heading">Name your intention</string>
    <string name="onboarding_page2_body">Before the app opens, you pick why you\'re opening it. No scores, no streaks, no lectures.</string>
    <string name="onboarding_page3_heading">Your data stays here</string>
    <string name="onboarding_page3_body">Everything is stored only on this device. No accounts, no sync, no analytics. You can delete it all from settings at any time.</string>

